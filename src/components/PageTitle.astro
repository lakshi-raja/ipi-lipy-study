---
const route: any = Astro.locals?.starlightRoute ?? {};
const entry = route.entry ?? (Astro.props as any)?.entry;
const ipi = entry?.data?.ipi;
const chapter = ipi?.chapter ?? '';
const group = ipi?.group ?? '';
const refs = ipi?.refs ?? '';
const title = entry?.data?.title ?? '';
---
<header class="ipi-page-header">
  {group && <div class="ipi-page-header__group">{group}</div>}
  {chapter && <div class="ipi-page-header__num">{chapter}</div>}
  <h1 class="ipi-page-header__title" id="_top">{title}</h1>
  {refs && <div class="ipi-page-header__refs">{refs}</div>}
</header>

<script>
  // Wrap tables in a scroll container + flag wide matrices for sticky-column treatment.
  const enhanceTables = () => {
    document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return;
      const wrap = document.createElement('div');
      wrap.className = 'table-wrapper';
      const headerCells = table.tHead?.rows?.[0]?.cells?.length ?? 0;
      if (headerCells >= 5) wrap.classList.add('is-matrix');
      table.parentElement?.insertBefore(wrap, table);
      wrap.appendChild(table);
      const check = () => {
        if (wrap.scrollWidth > wrap.clientWidth + 2) wrap.classList.add('is-overflowing');
        else wrap.classList.remove('is-overflowing');
      };
      check();
      new ResizeObserver(check).observe(wrap);
    });
  };
  enhanceTables();
  document.addEventListener('astro:page-load', enhanceTables);
</script>
